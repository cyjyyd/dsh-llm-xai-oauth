{
  "name": "dsh-llm-xai-oauth",
  "version": "0.1.6",
  "description": "Use a SuperGrok / X Premium subscription inside DeepSeek Harness. Device-code OAuth, grok-bridge token reuse, no xAI API key. Works in headless, web, and any TUI.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "xai",
    "grok",
    "grok-4.6",
    "oauth",
    "supergrok",
    "x-premium",
    "llm-provider",
    "subscription",
    "headless"
  ],
  "author": "cyjyyd",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-llm-xai-oauth": "lib/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.1 <0.1.5-rc.2 || >=0.1.5-rc.2 <0.1.5-rc.3 || >=0.1.5-rc.3 <0.1.6-0 || >=0.1.7-rc.1 <0.1.7-rc.2",
      "dshReleases": {
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible",
        "0.1.5-rc.3": "compatible",
        "0.1.7-rc.1": "compatible"
      },
      "profiles": [
        "tui",
        "headless",
        "web"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "login": "npm run build && node lib/login.js",
    "refresh": "npm run build && node lib/cli.js refresh",
    "daemon": "npm run build && node lib/cli.js daemon",
    "clean": "rm -rf lib",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck",
    "install:dsh": "bash scripts/install.sh",
    "install:npm": "bash scripts/install-npm.sh"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/schemastery": "^3.18.2",
    "eventsource-parser": "^3.1.0",
    "undici": "^7.16.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": ">=0.1.5-rc.1 <0.1.5-rc.2 || >=0.1.5-rc.2 <0.1.5-rc.3 || >=0.1.5-rc.3 <0.1.6-0 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-invariants": ">=0.1.5-rc.1 <0.1.5-rc.2 || >=0.1.5-rc.2 <0.1.5-rc.3 || >=0.1.5-rc.3 <0.1.6-0 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.5-rc.1 <0.1.5-rc.2 || >=0.1.5-rc.2 <0.1.5-rc.3 || >=0.1.5-rc.3 <0.1.6-0 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.1 <0.1.5-rc.2 || >=0.1.5-rc.2 <0.1.5-rc.3 || >=0.1.5-rc.3 <0.1.6-0 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc.1 <0.1.5-rc.2 || >=0.1.5-rc.2 <0.1.5-rc.3 || >=0.1.5-rc.3 <0.1.6-0 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-timeout": ">=0.1.5-rc.1 <0.1.5-rc.2 || >=0.1.5-rc.2 <0.1.5-rc.3 || >=0.1.5-rc.3 <0.1.6-0 || >=0.1.7-rc.1 <0.1.7-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.7-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.1",
    "@deepseek-ai/dsh-timeout": "0.1.7-rc.1",
    "@types/node": "^24.0.0",
    "semver": "^7.8.5",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyjyyd/dsh-llm-xai-oauth.git"
  },
  "homepage": "https://www.npmjs.com/package/dsh-llm-xai-oauth",
  "bugs": {
    "url": "https://github.com/cyjyyd/dsh-llm-xai-oauth/issues"
  }
}
